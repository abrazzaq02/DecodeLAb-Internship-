# AI Recommendation Engine - Environment Variables Template
# Copy this file to .env and fill in your values

# Flask Backend
FLASK_APP=backend/app.py
FLASK_ENV=production
FLASK_DEBUG=False
PORT=5000

# Frontend API URL
VITE_API_URL=http://localhost:5000

# Secret Key (generate a strong random key for production)
SECRET_KEY=your-secret-key-here
